  "schema_kind": "Exact Go schema source declarations, not SDK-generated JSON Schema; resolve root types in schema-types.json. PORT-002 captures tools/list from a binary built at the pin.",
  "custom_schema": {
    "source": "internal/mcp/server/args.go:133",
    "signature": "func taskCompleteSchema() *jsonschema.Schema {\r",
    "declaration": "func taskCompleteSchema() *jsonschema.Schema {\r\n\ts, err := jsonschema.For[taskCompleteInput](nil)\r\n\tif err != nil {\r\n\t\tpanic(err) // a static type: fails in every test run\r\n\t}\r\n\tif v := s.Properties[\"validation\"]; v != nil && v.Items != nil {\r\n\t\tobj := v.Items\r\n\t\tv.Items = &jsonschema.Schema{AnyOf: []*jsonschema.Schema{{Type: \"string\", Description: \"a command that passed\"}, obj}}\r\n\t\tv.Types, v.Type = []string{\"null\", \"array\"}, \"\"\r\n\t}\r\n\treturn s\r\n}"
  },
  "argument_hints": {
    "source": "internal/mcp/server/args.go:84",
    "signature": "func (s *Server) argumentHint(tool string, raw json.RawMessage) string {\r",
    "declaration": "func (s *Server) argumentHint(tool string, raw json.RawMessage) string {\r\n\tvar lines []string\r\n\tvar given map[string]any\r\n\tjson.Unmarshal(raw, &given)\r\n\tfor _, prop := range slices.Sorted(maps.Keys(given)) {\r\n\t\tif fix, ok := pitfalls[tool][prop]; ok {\r\n\t\t\tlines = append(lines, prop+\": \"+fix)\r\n\t\t}\r\n\t}\r\n\tif a, ok := s.args[tool]; ok {\r\n\t\texp := \"expected arguments: required \" + orNothing(a.required)\r\n\t\tif len(a.optional) > 0 {\r\n\t\t\texp += \"; optional \" + strings.Join(a.optional, \", \")\r\n\t\t}\r\n\t\tlines = append(lines, exp)\r\n\t}\r\n\tif tool == \"task_complete\" {\r\n\t\tlines = append(lines, `acceptance: [{\"index\": 1, \"result\": \"pass\", \"evidence\": \"...\"}] (one per criterion; [] when the task has none); `+\r\n\t\t\t`validation: [\"go test ./...\"] or [{\"command\": \"...\", \"result\": \"pass\"}]`)\r\n\t}\r\n\treturn strings.Join(lines, \"\\n\")\r\n}"
  }
