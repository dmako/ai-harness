<Project Sdk="Microsoft.NET.Sdk">
  <!-- TASK-0097/0098 spikes: git process vs LibGit2Sharp and GitReader, published trimmed Native AOT like harness. Not part of harness.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="GitReader" Version="1.18.0" />
  </ItemGroup>
</Project>
