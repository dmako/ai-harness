<Project Sdk="Microsoft.NET.Sdk">
  <!-- TASK-0111 spike: harness's MCP provider call path against Microsoft.Extensions.AI (AIFunction, middleware,
       IChatClient/IEmbeddingGenerator), published trimmed Native AOT like harness. Not part of harness.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="size/**" />
    <!-- The MCP SDK version harness pins; it brings Microsoft.Extensions.AI.Abstractions 10.11.0 with it. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
    <!-- Latest stable; only the compose command's pipeline (FunctionInvokingChatClient) needs it. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>
</Project>
