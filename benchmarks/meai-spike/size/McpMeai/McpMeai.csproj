<Project Sdk="Microsoft.NET.Sdk">
  <!-- TASK-0111 size probe: see ../Probe.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <DefineConstants>$(DefineConstants);MEAI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Probe.cs" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>
</Project>
