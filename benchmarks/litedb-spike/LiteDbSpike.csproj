<Project Sdk="Microsoft.NET.Sdk">
  <!-- TASK-0110 spike: SQLite (as harness uses it) against LiteDB, published trimmed Native AOT like harness. Not part of harness.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <LiteDbVersion Condition="'$(LiteDbVersion)' == ''">5.0.21</LiteDbVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="size/**" />
    <PackageReference Include="LiteDB" Version="$(LiteDbVersion)" />
    <!-- The same provider version harness pins (Directory.Packages.props NetSdkVersion). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
</Project>
