<Project Sdk="Microsoft.NET.Sdk">
  <!-- TASK-0112 spike: start, cancel, interrupt and resume Claude Code and Codex sessions through Microsoft Agent
       Framework bridges, published trimmed Native AOT like harness. Not part of harness.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="size/**" />
    <!-- Latest stable bridges; each brings its core SDK and Microsoft.Agents.AI >= 1.21.0. -->
    <PackageReference Include="ClaudeCodeSdk.MAF" Version="10.4.4" />
    <PackageReference Include="CodexSdk.MAF" Version="10.0.3" />
  </ItemGroup>
</Project>
