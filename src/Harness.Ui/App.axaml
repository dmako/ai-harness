<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Harness.Ui.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Harness.Ui/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://Harness.Ui/Styles/Blueprints.axaml" />
        <ResourceInclude Source="avares://Harness.Ui/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Harness.Ui/Styles/Base.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Chips.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Sections.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Tables.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Forms.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Navigation.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Feedback.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Shell.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Board.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/BlueprintFrames.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Overview.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Work.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Knowledge.axaml" />
    <StyleInclude Source="avares://Harness.Ui/Styles/Architecture.axaml" />
  </Application.Styles>
</Application>
