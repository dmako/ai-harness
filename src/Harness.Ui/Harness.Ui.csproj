<Project Sdk="Microsoft.NET.Sdk">
  <!-- harness ui in Avalonia (TASK-0144 spike): views, view models, styles and the typed API client shared by every
       host (browser now, desktop later). It references no harness project: it only speaks harness ui's HTTP API. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DynamicData" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harness.Ui.Tests" />
  </ItemGroup>
</Project>
