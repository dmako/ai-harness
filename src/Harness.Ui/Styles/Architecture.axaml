<!-- Architecture (style.css .amap, .anode, .smell, .cxbar): the layer graph's nodes (selected, what it references,
     what references it, the rest dimmed), the findings' cards and the hotspots' bars. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Harness.Ui.Controls">
  <Style Selector="Border.project-mark">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GoldInk}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.project-mark TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GoldInk}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.project-mark.compact">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.project-mark.compact TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="8" />
  </Style>
  <Style Selector="Border.project-mark.pc0"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill0}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder0}" /></Style>
  <Style Selector="Border.project-mark.pc0 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk0}" /></Style>
  <Style Selector="Border.project-mark.pc1"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill1}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder1}" /></Style>
  <Style Selector="Border.project-mark.pc1 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk1}" /></Style>
  <Style Selector="Border.project-mark.pc2"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill2}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder2}" /></Style>
  <Style Selector="Border.project-mark.pc2 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk2}" /></Style>
  <Style Selector="Border.project-mark.pc3"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill3}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder3}" /></Style>
  <Style Selector="Border.project-mark.pc3 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk3}" /></Style>
  <Style Selector="Border.project-mark.pc4"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill4}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder4}" /></Style>
  <Style Selector="Border.project-mark.pc4 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk4}" /></Style>
  <Style Selector="Border.project-mark.pc5"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill5}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder5}" /></Style>
  <Style Selector="Border.project-mark.pc5 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk5}" /></Style>
  <Style Selector="Border.project-mark.pc6"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill6}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder6}" /></Style>
  <Style Selector="Border.project-mark.pc6 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk6}" /></Style>
  <Style Selector="Border.project-mark.pc7"><Setter Property="Background" Value="{DynamicResource ProjectMarkFill7}" /><Setter Property="BorderBrush" Value="{DynamicResource ProjectMarkBorder7}" /></Style>
  <Style Selector="Border.project-mark.pc7 TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectMarkInk7}" /></Style>
  <Style Selector="Button.health-badge">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.health-badge">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="TextBlock.health-dot.g-ok"><Setter Property="Foreground" Value="{DynamicResource GoodInk}" /></Style>
  <Style Selector="TextBlock.health-dot.g-warn"><Setter Property="Foreground" Value="{DynamicResource GoldInk}" /></Style>
  <Style Selector="TextBlock.health-dot.g-bad"><Setter Property="Foreground" Value="{DynamicResource Critical}" /></Style>
  <Style Selector="Border.language-mark">
    <Setter Property="Background" Value="#5140a4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.language-mark TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="Border.layer-band">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="Button.matrix-switch">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.matrix-switch.selected">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.matrix-mark">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.matrix-mark.build">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.matrix-mark.back">
    <Setter Property="Background" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="Button.matrix-row, Button.matrix-column, Button.matrix-edge">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
  </Style>
  <Style Selector="Button.matrix-row">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.matrix-column, Button.matrix-edge">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.matrix-edge">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.matrix-edge c|Icon">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.matrix-edge.back">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="Button.matrix-row.sel, Button.matrix-column.sel, Button.matrix-edge.sel">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.package-up">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.package-vuln">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Button.package-vuln.severe">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="Button.anode">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="Border.node-accent">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="7,6,10,6" />
  </Style>
  <Style Selector="Button.anode.role-model Border.node-accent, Button.anode.role-base Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource CFact}" />
  </Style>
  <Style Selector="Button.anode.role-data Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource CConstraint}" />
  </Style>
  <Style Selector="Button.anode.role-logic Border.node-accent, Button.anode.role-feature Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource CDecision}" />
  </Style>
  <Style Selector="Button.anode.role-api Border.node-accent, Button.anode.role-page Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource CConvention}" />
  </Style>
  <Style Selector="Button.anode.role-test Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource CWarning}" />
  </Style>
  <Style Selector="Button.anode.role-hooks Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource COpenQuestion}" />
  </Style>
  <Style Selector="Button.anode.role-ui Border.node-accent">
    <Setter Property="BorderBrush" Value="{DynamicResource CGoal}" />
  </Style>
  <Style Selector="Button.anode.sel">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>
  <Style Selector="Button.anode.rel-out">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.anode.rel-in">
    <Setter Property="BorderBrush" Value="{DynamicResource CConvention}" />
  </Style>
  <Style Selector="Button.anode.dim">
    <Setter Property="Background" Value="{DynamicResource Page}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="Button.anode.dim TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style Selector="Border.smell">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <!-- a kind's group (three or more) is its Expander: the shared card with its header band, so no frame around it -->
  <Style Selector="Border.smell.group">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.smell.quiet">
    <Setter Property="Background" Value="{DynamicResource Page}" />
  </Style>
  <!-- a smell's head (style.css .attn li.smell summary): its level as a pill, the title, its tags -->
  <Style Selector="Border.smell Border.pill">
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Border.smell Border.pill c|Icon">
    <Setter Property="Size" Value="12" />
  </Style>
  <!-- what could help (style.css .sfix): its label in the accent, first in the body -->
  <Style Selector="SelectableTextBlock.sfix">
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.smell Expander">
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.side">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <!-- the build map's members (app.js .dep-node2): focused, used, using, dimmed, in a cycle, a library -->
  <Style Selector="Button.dnode">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="Button.dnode.lib">
    <Setter Property="BorderBrush" Value="{DynamicResource Axis}" />
  </Style>
  <Style Selector="Button.dnode.cycle">
    <Setter Property="BorderBrush" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="Button.dnode.focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>
  <Style Selector="Button.dnode.uses">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.dnode.usedby">
    <Setter Property="BorderBrush" Value="{DynamicResource CConvention}" />
  </Style>
  <Style Selector="Button.dnode.dim">
    <Setter Property="Background" Value="{DynamicResource Page}" />
  </Style>
  <Style Selector="Button.dnode.dim TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <!-- a design issue in the list (style.css .irow): hover lifts the fill, the one shown is washed and outlined in the
       accent; Fluent's state fills are replaced, the checked state last so it wins -->
  <Style Selector="ToggleButton.irow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="ToggleButton.irow:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.irow:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ToggleButton.irow:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ToggleButton.irow:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ToggleButton.irow:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <!-- its summary in Ink 2 (style.css .irow .isum), which keeps AA on the accent wash -->
  <Style Selector="ToggleButton.irow TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
  </Style>
</Styles>
