<!-- Page-wide styles: the page itself, the header and the live state. Components are in their own files. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Harness.Ui.Controls">
  <!-- keyboard focus (brand.css :focus-visible): the Accent ring 2 px outside a control, following its corners, in place
       of Fluent's square white-and-black adorner -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <c:FocusRing BorderBrush="{DynamicResource Accent}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- a text field marks its focus with its own Accent border (style.css input:focus), not a ring around it -->
  <Style Selector="TextBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(UserControl).page">
    <Setter Property="Background" Value="{DynamicResource Page}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="{StaticResource TextMd}" />
  </Style>
  <Style Selector="Border.header">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource TextLg}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.brandSeparator">
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="FontSize" Value="{StaticResource TextLg}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.live">
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.live.connected">
    <Setter Property="Foreground" Value="{DynamicResource GoodInk}" />
  </Style>
  <Style Selector="TextBlock.live.offline">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
