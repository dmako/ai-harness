<!-- The harness design system's semantic tokens (brand.css, TASK-0022) for Light and Dark, with brand.css's
     color-mix() values computed. Views and component styles use only these names: they never write a colour, font
     size, radius or spacing themselves. Generated from the palette in brand.css; keep them in step. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Page" Color="#ffffff" />
      <SolidColorBrush x:Key="Surface" Color="#ffffff" />
      <SolidColorBrush x:Key="Surface2" Color="#f6f7f8" />
      <SolidColorBrush x:Key="Chip" Color="#ffffff" />
      <SolidColorBrush x:Key="Inset" Color="#ffffff" />
      <SolidColorBrush x:Key="Ink" Color="#1c1c1b" />
      <SolidColorBrush x:Key="Ink2" Color="#494949" />
      <SolidColorBrush x:Key="Muted" Color="#6e6e6d" />
      <SolidColorBrush x:Key="Border" Color="#241c1c1b" />
      <SolidColorBrush x:Key="Grid" Color="#e8e8e8" />
      <SolidColorBrush x:Key="Axis" Color="#c4c4c4" />
      <SolidColorBrush x:Key="Accent" Color="#006b6c" />
      <SolidColorBrush x:Key="AccentWash" Color="#cfe6e4" />
      <SolidColorBrush x:Key="Selected" Color="#f0f6f6" />
      <SolidColorBrush x:Key="Fill" Color="#006b6c" />
      <SolidColorBrush x:Key="OnFill" Color="#ffffff" />
      <SolidColorBrush x:Key="Gold" Color="#e2a33b" />
      <SolidColorBrush x:Key="GoldHover" Color="#f0c26a" />
      <SolidColorBrush x:Key="GoldInk" Color="#7d5208" />
      <SolidColorBrush x:Key="OnGold" Color="#141413" />
      <SolidColorBrush x:Key="Good" Color="#1f9d55" />
      <SolidColorBrush x:Key="GoodInk" Color="#146c3a" />
      <SolidColorBrush x:Key="Warning" Color="#e2a33b" />
      <SolidColorBrush x:Key="Serious" Color="#d9733f" />
      <SolidColorBrush x:Key="Critical" Color="#c7413b" />
      <!-- text on a Critical fill (danger buttons, failure ticks): white on the light red, near black on the dark one -->
      <SolidColorBrush x:Key="OnCritical" Color="#ffffff" />
      <SolidColorBrush x:Key="CGoal" Color="#006b6c" />
      <SolidColorBrush x:Key="CConstraint" Color="#d0612c" />
      <SolidColorBrush x:Key="CDecision" Color="#1b8f66" />
      <SolidColorBrush x:Key="COpenQuestion" Color="#b47a12" />
      <SolidColorBrush x:Key="CFact" Color="#3f7d2a" />
      <SolidColorBrush x:Key="CConvention" Color="#5b4bb3" />
      <SolidColorBrush x:Key="CWarning" Color="#c7413b" />
      <SolidColorBrush x:Key="Backdrop" Color="#8cffffff" />
      <SolidColorBrush x:Key="InsetLine" Color="#241c1c1b" />
      <BoxShadows x:Key="CardShadow">0 1 2 0 #12141413, 0 4 14 0 #0d141413</BoxShadows>
      <BoxShadows x:Key="Shadow1">0 1 2 0 #1a141413</BoxShadows>
      <BoxShadows x:Key="Shadow2">0 8 24 0 #2e141413</BoxShadows>
      <BoxShadows x:Key="GlowGold">0 8 24 0 #38e2a33b</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Page" Color="#141413" />
      <SolidColorBrush x:Key="Surface" Color="#1c1c1b" />
      <SolidColorBrush x:Key="Surface2" Color="#252523" />
      <SolidColorBrush x:Key="Chip" Color="#252523" />
      <SolidColorBrush x:Key="Inset" Color="#252523" />
      <SolidColorBrush x:Key="Ink" Color="#f3ecdf" />
      <SolidColorBrush x:Key="Ink2" Color="#c2bbae" />
      <SolidColorBrush x:Key="Muted" Color="#9b958a" />
      <SolidColorBrush x:Key="Border" Color="#1af3ecdf" />
      <SolidColorBrush x:Key="Grid" Color="#2d2d2a" />
      <SolidColorBrush x:Key="Axis" Color="#3c3b37" />
      <SolidColorBrush x:Key="Accent" Color="#4fb4b1" />
      <SolidColorBrush x:Key="AccentWash" Color="#0d3f40" />
      <SolidColorBrush x:Key="Selected" Color="#1f2524" />
      <SolidColorBrush x:Key="Fill" Color="#006b6c" />
      <SolidColorBrush x:Key="OnFill" Color="#f3ecdf" />
      <SolidColorBrush x:Key="Gold" Color="#e2a33b" />
      <SolidColorBrush x:Key="GoldHover" Color="#f0c26a" />
      <SolidColorBrush x:Key="GoldInk" Color="#f0c26a" />
      <SolidColorBrush x:Key="OnGold" Color="#141413" />
      <SolidColorBrush x:Key="Good" Color="#2fb36a" />
      <SolidColorBrush x:Key="GoodInk" Color="#52c784" />
      <SolidColorBrush x:Key="Warning" Color="#e2a33b" />
      <SolidColorBrush x:Key="Serious" Color="#e0874f" />
      <SolidColorBrush x:Key="Critical" Color="#e0605a" />
      <SolidColorBrush x:Key="OnCritical" Color="#141413" />
      <SolidColorBrush x:Key="CGoal" Color="#4fb4b1" />
      <SolidColorBrush x:Key="CConstraint" Color="#e07a45" />
      <SolidColorBrush x:Key="CDecision" Color="#3fbf8f" />
      <SolidColorBrush x:Key="COpenQuestion" Color="#e2a33b" />
      <SolidColorBrush x:Key="CFact" Color="#7fb860" />
      <SolidColorBrush x:Key="CConvention" Color="#9d90f0" />
      <SolidColorBrush x:Key="CWarning" Color="#e66767" />
      <SolidColorBrush x:Key="Backdrop" Color="#8c141413" />
      <SolidColorBrush x:Key="InsetLine" Color="#00000000" />
      <BoxShadows x:Key="CardShadow">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="Shadow1">0 1 2 0 #66141413</BoxShadows>
      <BoxShadows x:Key="Shadow2">0 12 32 0 #8c141413</BoxShadows>
      <BoxShadows x:Key="GlowGold">0 8 24 0 #38e2a33b</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- type: five sizes, one role each (xs captions and badges, sm secondary text and tables, md body, lg card and
       section titles, xl page titles) -->
  <x:Double x:Key="TextXs">12</x:Double>
  <x:Double x:Key="TextSm">13</x:Double>
  <x:Double x:Key="TextMd">14</x:Double>
  <x:Double x:Key="TextLg">16</x:Double>
  <x:Double x:Key="TextXl">24</x:Double>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

  <!-- shape -->
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- space (brand.css space-n at 16 px to the rem) -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>
  <x:Double x:Key="Space12">48</x:Double>
  <x:Double x:Key="ContentWidth">1040</x:Double>

  <!-- the smallest a control may be in either direction (WCAG 2.5.8, UiChecks' 24 px check) -->
  <x:Double x:Key="ControlMin">24</x:Double>
  <x:Double x:Key="ColumnWidth">232</x:Double>
  <!-- below this window height the page scrolls instead of squeezing the Board's columns -->
  <x:Double x:Key="PageMinHeight">520</x:Double>
</ResourceDictionary>
