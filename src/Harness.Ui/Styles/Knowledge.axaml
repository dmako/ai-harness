<!-- Knowledge (style.css .mem, .ty-<type>, .shared): a memory's card with a stripe in its type's colour, dimmed
     when superseded or expired; the PROJECT and removed tags. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.mem">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.mem.inactive">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Border.mem.ty-goal">
    <Setter Property="BorderBrush" Value="{DynamicResource CGoal}" />
  </Style>
  <Style Selector="Border.mem.ty-constraint">
    <Setter Property="BorderBrush" Value="{DynamicResource CConstraint}" />
  </Style>
  <Style Selector="Border.mem.ty-decision">
    <Setter Property="BorderBrush" Value="{DynamicResource CDecision}" />
  </Style>
  <Style Selector="Border.mem.ty-convention">
    <Setter Property="BorderBrush" Value="{DynamicResource CConvention}" />
  </Style>
  <Style Selector="Border.mem.ty-warning">
    <Setter Property="BorderBrush" Value="{DynamicResource CWarning}" />
  </Style>
  <Style Selector="Border.mem.ty-fact">
    <Setter Property="BorderBrush" Value="{DynamicResource CFact}" />
  </Style>
  <Style Selector="Border.mem.ty-open_question">
    <Setter Property="BorderBrush" Value="{DynamicResource COpenQuestion}" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TextXs}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.tag.removed">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
