<!-- Feedback (style.css .toast, .dlg): a toast is a pill with a round tick (good, or critical with .bad and its detail
     below); a dialog is a raised Surface card over a Backdrop, 520 px wide (680 with .wide). -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Harness.Ui.Controls">
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow2}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MaxWidth" Value="520" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Border.toast.bad">
    <Setter Property="BorderBrush" Value="{DynamicResource Critical}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>
  <Style Selector="Border.toast TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toast TextBlock.detail">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextXs}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
  </Style>
  <Style Selector="Border.tick">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="{DynamicResource Good}" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tick c|Icon">
    <Setter Property="Size" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource OnFill}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toast.bad Border.tick">
    <Setter Property="Background" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="Border.toast.bad Border.tick c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource OnCritical}" />
  </Style>

  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="{DynamicResource Backdrop}" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow2}" />
    <Setter Property="MaxWidth" Value="520" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.dialog.wide">
    <Setter Property="MaxWidth" Value="680" />
  </Style>
  <Style Selector="Border.dialog TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource TextLg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.dialog TextBlock.sub">
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.dialog-head">
    <Setter Property="Padding" Value="20,16,20,8" />
  </Style>
  <Style Selector="Border.dialog-body">
    <Setter Property="Padding" Value="20,8" />
  </Style>
  <Style Selector="Border.dialog-foot">
    <Setter Property="Padding" Value="20,12,20,16" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
</Styles>
