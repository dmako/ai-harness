<!-- Labels and toggles (brand.css, style.css): .pill for a status or tag (st-<status>, lv-<level> colour its icon),
     .badge for a count, ToggleButton.chip for a filter that is on or off, Button.copychip for a name an agent uses
     that one click copies, and the priority marks (Icon.prio.p-<priority>). Status and level colours go to the icon
     only: the words stay in the inks, so their contrast never depends on a hue. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Harness.Ui.Controls">
  <Style Selector="Border.pill">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill c|Icon">
    <Setter Property="Size" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.st-ready c|Icon, Border.lv-info c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.st-claimed c|Icon, Border.st-in_progress c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource CConvention}" />
  </Style>
  <Style Selector="Border.st-review c|Icon, Border.lv-warn c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Border.st-blocked c|Icon, Border.lv-fail c|Icon, Border.lv-problem c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="Border.st-done c|Icon, Border.lv-ok c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Good}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TextXs}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="{StaticResource ControlMin}" />
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Button.copychip">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextXs}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="10,2" />
  </Style>
  <Style Selector="Button.copychip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.copychip.copied /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Good}" />
  </Style>

  <!-- priorities: the mark in the priority's colour, the word in the inks -->
  <!-- a task type's mark (app.js typeMark, .opt-<type>): its icon in the type's own colour -->
  <Style Selector="c|Icon.type">
    <Setter Property="Size" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
  </Style>
  <Style Selector="c|Icon.ty-feature">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="c|Icon.ty-bug">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
  </Style>
  <Style Selector="c|Icon.ty-spike">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="c|Icon.ty-docs">
    <Setter Property="Foreground" Value="{DynamicResource CConvention}" />
  </Style>
  <Style Selector="c|Icon.ty-test">
    <Setter Property="Foreground" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="c|Icon.ty-process">
    <Setter Property="Foreground" Value="{DynamicResource COpenQuestion}" />
  </Style>

  <Style Selector="c|Icon.prio">
    <Setter Property="Size" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|Icon.prio.p-low">
    <Setter Property="Foreground" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="c|Icon.prio.p-medium">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="c|Icon.prio.p-high">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="c|Icon.prio.p-critical">
    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
  </Style>
</Styles>
