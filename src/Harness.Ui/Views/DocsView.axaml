<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:preview="using:Harness.Ui.Preview"
             xmlns:c="using:Harness.Ui.Controls"
             x:Class="Harness.Ui.Views.DocsView"
             x:DataType="vm:DocsPage"
             d:DataContext="{x:Static preview:PreviewData.Docs}">
  <!-- Docs (app.js renderDocs): the sections beside the text when there is room, above it when narrow
       (DocsView.axaml.cs), and the sections before and after -->
  <StackPanel Spacing="12">
    <StackPanel Classes="phead">
      <TextBlock Classes="h2" Text="Docs" />
      <TextBlock Classes="path" TextWrapping="Wrap" Text="The guide and the reference this harness carries; 'harness docs &lt;section&gt;' prints the same." />
      <Border Name="HeaderSeparator" Width="130" Height="1" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="0,6,0,0" />
    </StackPanel>
    <Grid Name="Columns" ColumnSpacing="24" RowSpacing="24">
      <ItemsControl Name="DocList" ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocGroup">
            <StackPanel Spacing="2" Margin="0,0,0,12">
              <c:AppLink Classes="nav" Classes.current="{Binding Intro.Current}" Href="{Binding Intro.Href}" AutomationProperties.Name="{Binding Title}" IsVisible="{Binding HasIntro}">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
              </c:AppLink>
              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" IsVisible="{Binding !HasIntro}" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DocLink">
                    <c:AppLink Classes="nav" Classes.current="{Binding Current}" Href="{Binding Href}" AutomationProperties.Name="{Binding Title}">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    </c:AppLink>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Name="Article" Spacing="16" MaxWidth="660" HorizontalAlignment="Left">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <c:DocsMarkdown Name="DocText" Markdown="{Binding Doc.Body}" />
        <Border Name="NavigationSeparator" Height="1" Background="{DynamicResource Border}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <c:AppLink Name="NextDoc" Grid.Column="1" Classes="doc-nav" Href="{Binding Next.Href}" AutomationProperties.Name="{Binding Next.Title, StringFormat='Next: {0}'}" IsVisible="{Binding Next, Converter={x:Static ObjectConverters.IsNotNull}}"
                     HorizontalAlignment="Right" MaxWidth="320">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted small" Text="Next" HorizontalAlignment="Right" />
              <TextBlock FontWeight="SemiBold" Text="{Binding Next.Title, StringFormat='{}{0} →'}" TextWrapping="Wrap" TextAlignment="Right" />
            </StackPanel>
          </c:AppLink>
          <c:AppLink Name="PreviousDoc" Grid.Column="0" Classes="doc-nav" Href="{Binding Previous.Href}" AutomationProperties.Name="{Binding Previous.Title, StringFormat='Previous: {0}'}" IsVisible="{Binding Previous, Converter={x:Static ObjectConverters.IsNotNull}}"
                     HorizontalAlignment="Left" MaxWidth="320">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted small" Text="Previous" />
              <TextBlock FontWeight="SemiBold" Text="{Binding Previous.Title, StringFormat='← {0}'}" TextWrapping="Wrap" />
            </StackPanel>
          </c:AppLink>
        </Grid>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
