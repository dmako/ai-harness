<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:preview="using:Harness.Ui.Preview"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:c="using:Harness.Ui.Controls"
             x:Class="Harness.Ui.Views.TaskDialogView"
             x:DataType="vm:TaskDialog"
             d:DataContext="{x:Static preview:PreviewData.TaskDialog}">
  <!-- a task (app.js taskDialog/taskDetail): its detail inset in a rounded block, the content (why blocked or deferred,
       goal, criteria, completion, notes, sessions, audit trail) beside a card of its facts, which goes under the
       content on a narrow screen. Delete… and Edit… are the dialog's footer actions (TaskDialog.Actions); the
       blueprint is changed in the facts' Blueprint. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="muted" Text="Loading…" IsVisible="{Binding !HasTask}" />
    <Border Classes="error" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding LoadError}" />
    </Border>
    <Border Classes="tdetail" IsVisible="{Binding HasTask}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" c:SidePanel.Follows="True" c:SidePanel.Gap="18">
        <StackPanel Classes="tmain" Spacing="16">
          <Border Classes="callout" Classes.bad="{Binding CalloutBad}" IsVisible="{Binding HasCallout}">
            <SelectableTextBlock Text="{Binding Callout}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Spacing="6" IsVisible="{Binding HasGoal}">
            <TextBlock Classes="tlabel" Text="GOAL" />
            <SelectableTextBlock Text="{Binding Task.Goal}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasCriteria}">
            <WrapPanel ItemSpacing="8">
              <TextBlock Classes="tlabel" Text="ACCEPTANCE CRITERIA" />
              <TextBlock Classes="tcount" Text="{Binding CriteriaCount}" />
            </WrapPanel>
            <ItemsControl Name="Criteria" ItemsSource="{Binding Criteria}" ItemTemplate="{StaticResource CheckRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasCompletion}">
            <TextBlock Classes="tlabel" Text="COMPLETED" />
            <SelectableTextBlock Text="{Binding Task.Completion.Summary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckRowTemplate}" IsVisible="{Binding HasChecks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasNotes}">
            <TextBlock Classes="tlabel" Text="NOTES" />
            <SelectableTextBlock Classes="muted" Text="{Binding Task.Notes}" TextWrapping="Wrap" />
          </StackPanel>
            <StackPanel Name="Sessions" Spacing="4">
              <TextBlock Classes="tlabel" Text="AGENT SESSIONS" />
              <TextBlock Classes="small" Text="{Binding SessionsUsage}" TextWrapping="Wrap"
                         IsVisible="{Binding HasSessionsUsage}" />
              <TextBlock Classes="muted small" Text="{Binding SessionsNote}" TextWrapping="Wrap"
                         IsVisible="{Binding SessionsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="error" Text="{Binding AgentSessions.Error}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionRow">
                    <StackPanel Margin="0,2">
                      <WrapPanel ItemSpacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Client}" />
                        <SelectableTextBlock Classes="mono small" Text="{Binding FullId}" VerticalAlignment="Center"
                                             TextWrapping="Wrap" />
                        <TextBlock Classes="small" Text="{Binding Status}" VerticalAlignment="Center" />
                        <TextBlock Classes="muted small" Text="{Binding Seen}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                      </WrapPanel>
                      <TextBlock Classes="muted small" Text="{Binding Usage}" TextWrapping="Wrap" />
                      <Button Classes="ghost" Content="Show transcript" AutomationProperties.Name="Show transcript"
                              Command="{Binding ShowTranscriptCommand}"
                              IsVisible="{Binding CanShowTranscript}" HorizontalAlignment="Left" />
                      <SelectableTextBlock Text="{Binding Transcript}" TextWrapping="Wrap"
                                           IsVisible="{Binding Transcript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel IsVisible="{Binding CanResume}" Spacing="4">
                        <TextBox Text="{Binding ResumePrompt}" AutomationProperties.Name="Prompt to resume with"
                                 AcceptsReturn="True" TextWrapping="Wrap" />
                        <Button Content="Resume" AutomationProperties.Name="Resume" Command="{Binding ResumeCommand}"
                                HorizontalAlignment="Left" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander Header="Start an agent on this task" AutomationProperties.Name="Start an agent on this task"
                        IsExpanded="{Binding AgentSessions.FormOpen}">
                <StackPanel DataContext="{Binding AgentSessions}" x:DataType="vm:AgentSessionsViewModel" Spacing="6">
                  <TextBlock Classes="label" Text="Agent" />
                  <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client}"
                            AutomationProperties.Name="Agent" HorizontalAlignment="Stretch" />
                  <TextBlock Classes="label" Text="Model" />
                  <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}"
                            AutomationProperties.Name="Model"
                            HorizontalAlignment="Stretch" />
                  <TextBox Text="{Binding OtherModel}" PlaceholderText="Model id" AutomationProperties.Name="Model id"
                           IsVisible="{Binding OtherModelVisible}" />
                  <TextBlock Classes="muted small" Text="{Binding ModelNote}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="Permission mode" />
                  <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                            AutomationProperties.Name="Permission mode" HorizontalAlignment="Stretch" />
                  <TextBlock Classes="muted small" Text="{Binding ModeDescription}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="Prompt" />
                  <TextBox Text="{Binding Prompt}" AutomationProperties.Name="First prompt" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="70" />
                  <TextBlock Classes="muted small"
                             Text="The agent runs in its own process and continues when this page closes. Tool calls may wait here for approval."
                             TextWrapping="Wrap" />
                  <Button Content="Start" AutomationProperties.Name="Start" Command="{Binding StartCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Expander>
              <ItemsControl ItemsSource="{Binding AgentSessions.Hosts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentPanel">
                    <Border Classes="inset" Margin="0,4">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Status}" />
                        <ItemsControl ItemsSource="{Binding Entries}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentLogRow">
                              <StackPanel Margin="0,3" Spacing="4">
                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted small" Text="{Binding Answer}" />
                                <WrapPanel IsVisible="{Binding IsApproval}" ItemSpacing="6">
                                  <Button Content="Allow" AutomationProperties.Name="Allow"
                                          Command="{Binding AllowCommand}" />
                                  <Button Content="Deny" AutomationProperties.Name="Deny"
                                          Command="{Binding DenyCommand}" />
                                </WrapPanel>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Message}" AutomationProperties.Name="Message to the agent"
                                 AcceptsReturn="True" TextWrapping="Wrap" IsVisible="{Binding Alive}"
                                 PlaceholderText="Message to the agent" />
                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                          <Button Content="Send" AutomationProperties.Name="Send" Command="{Binding SendCommand}"
                                  IsVisible="{Binding CanSend}" />
                          <Button Content="Stop" AutomationProperties.Name="Stop" Command="{Binding StopCommand}"
                                  IsVisible="{Binding CanStop}" />
                          <Button Content="Close session" AutomationProperties.Name="Close session"
                                  Command="{Binding CloseCommand}" IsVisible="{Binding Alive}" />
                        </WrapPanel>
                        <StackPanel IsVisible="{Binding CanResume}" Spacing="4">
                          <TextBox Text="{Binding ResumePrompt}" AutomationProperties.Name="Prompt to resume with"
                                   AcceptsReturn="True" TextWrapping="Wrap" />
                          <Button Content="Resume" AutomationProperties.Name="Resume" Command="{Binding ResumeCommand}"
                                  HorizontalAlignment="Left" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Name="Trail" Spacing="4">
              <Button Name="ShowTrail" Classes="ghost" Content="Show audit trail"
                      AutomationProperties.Name="Show audit trail" Command="{Binding ShowTrailCommand}"
                      IsVisible="{Binding !TrailShown}" HorizontalAlignment="Left" />
              <TextBlock Classes="tlabel" Text="AUDIT TRAIL" IsVisible="{Binding TrailShown}" />
              <TextBlock Classes="error" Text="{Binding TrailError}"
                         IsVisible="{Binding TrailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ItemsControl ItemsSource="{Binding Trail}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventRow">
                    <StackPanel Margin="0,2">
                      <WrapPanel ItemSpacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Event}" />
                        <TextBlock Classes="small" Text="{Binding Move}" IsVisible="{Binding Moved}"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="muted small" Text="{Binding Who}" VerticalAlignment="Center" />
                      </WrapPanel>
                      <SelectableTextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap"
                                           IsVisible="{Binding HasDetail}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- its facts (app.js .tside): a label column and the values -->
        <Border Name="Facts" Grid.Column="1" Classes="tside" Width="300" VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="84,*">
              <TextBlock Classes="kvlabel" Text="Status" />
              <Border Grid.Column="1" Classes="pill" c:StyleClass.Name="{Binding StatusClass}">
                <StackPanel Orientation="Horizontal"><c:Icon Kind="{Binding StatusIcon}" /><TextBlock Text="{Binding StatusWord}" /></StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="84,*">
              <TextBlock Classes="kvlabel" Text="Priority" />
              <TextBlock Grid.Column="1" Classes="kvvalue" Text="{Binding Task.Priority, FallbackValue=''}" />
            </Grid>
            <Grid ColumnDefinitions="84,*">
              <TextBlock Classes="kvlabel" Text="Type" />
              <TextBlock Grid.Column="1" Classes="kvvalue" Text="{Binding Task.Type, FallbackValue=''}" />
            </Grid>
            <Grid ColumnDefinitions="84,*">
              <TextBlock Classes="kvlabel" Text="Blueprint" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="6">
                <ComboBox Name="MoveTo" ItemsSource="{Binding MoveChoices}" SelectedItem="{Binding MoveTo}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Blueprint" ToolTip.Tip="Move the task to another blueprint">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Name="Move" Content="Move" AutomationProperties.Name="Move" Command="{Binding MoveCommand}"
                        IsVisible="{Binding CanMove}" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="84,*" IsVisible="{Binding HasDependsOn}">
              <TextBlock Classes="kvlabel" Text="Depends on" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding DependsOn}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DependencyRow">
                    <WrapPanel ItemSpacing="6" LineSpacing="2">
                      <SelectableTextBlock Classes="mono small" Text="{Binding Id}" VerticalAlignment="Center" />
                      <Border Classes="pill" c:StyleClass.Name="{Binding StatusClass}" IsVisible="{Binding HasStatus}">
                        <StackPanel Orientation="Horizontal"><c:Icon Kind="{Binding StatusIcon}" /><TextBlock Text="{Binding StatusWord}" /></StackPanel>
                      </Border>
                    </WrapPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <Grid ColumnDefinitions="84,*" IsVisible="{Binding HasScope}">
              <TextBlock Classes="kvlabel" Text="Scope" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Scope}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><SelectableTextBlock Classes="mono small" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <Grid ColumnDefinitions="84,*" IsVisible="{Binding HasClaim}">
              <TextBlock Classes="kvlabel" Text="Claimed by" />
              <StackPanel Grid.Column="1">
                <SelectableTextBlock Classes="kvvalue" Text="{Binding ClaimedBy}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small" Text="{Binding ClaimedSince}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="84,*" IsVisible="{Binding HasDone}">
              <TextBlock Classes="kvlabel" Text="Done" />
              <StackPanel Grid.Column="1">
                <SelectableTextBlock Classes="kvvalue" Text="{Binding CompletedBy}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small" Text="{Binding CompletedAgo}" />
                <SelectableTextBlock Classes="mono small" Text="{Binding CompletedCommit}" IsVisible="{Binding HasCommit}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="84,*" IsVisible="{Binding HasValidation}">
              <TextBlock Classes="kvlabel" Text="Validation" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Validation}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><SelectableTextBlock Classes="mono small" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </StackPanel>
  <UserControl.Resources>
    <!-- a criterion or a validation check (app.js .checklist li): its own card, the result's mark beside the words and
         the evidence under them -->
    <DataTemplate x:Key="CheckRowTemplate" x:DataType="vm:CheckRow">
      <Border Classes="crit">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Classes="mark" Classes.pass="{Binding Passed}" Classes.fail="{Binding Failed}"
                     Text="{Binding Mark}" ToolTip.Tip="{Binding Result}" />
          <StackPanel Spacing="2">
            <SelectableTextBlock Classes.mono="{Binding Mono}" Text="{Binding Text}" TextWrapping="Wrap" />
            <SelectableTextBlock Classes="evidence" Text="{Binding Evidence}" IsVisible="{Binding HasEvidence}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
