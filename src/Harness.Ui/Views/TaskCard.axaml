<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:views="using:Harness.Ui.Views"
             xmlns:c="using:Harness.Ui.Controls"
             x:Class="Harness.Ui.Views.TaskCard"
             x:DataType="vm:TaskCardViewModel">
  <!-- a card (TASK-0084, app.js boardCard): the type's mark and the id (it opens the task's dialog) left, the
       priority's icon and word right; the title below, wrapping; the blueprint's title on one line under it, cut
       with an ellipsis -->
  <Border Classes="bcard" AutomationProperties.Name="{Binding Id}">
    <StackPanel Spacing="6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding PriorityTip}">
          <c:Icon Classes="prio" c:StyleClass.Name="{Binding Priority, StringFormat='p-{0}'}" Kind="{Binding PriorityIcon}" />
          <TextBlock Name="Priority" Classes="prio" Text="{Binding Priority}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Name="TypeMark" Classes="type" c:StyleClass.Name="{Binding TypeClass}" Kind="{Binding TypeIcon}"
                  ToolTip.Tip="{Binding Type}" VerticalAlignment="Center" />
          <Button Name="OpenTask" Classes="tid" Content="{Binding Id}" CommandParameter="{Binding Id}"
                  Command="{Binding $parent[views:BoardView].((vm:BoardViewModel)DataContext).OpenTaskCommand}"
                  AutomationProperties.Name="{Binding Id, StringFormat='Open {0}'}" />
        </StackPanel>
      </DockPanel>
      <SelectableTextBlock Name="Title" Classes="title" Text="{Binding Title}" />
      <Border Name="BlueprintFrame" Classes="bpframe" IsVisible="{Binding HasBlueprint}"
              ToolTip.Tip="{Binding BlueprintId}">
        <TextBlock Text="{Binding BlueprintText}" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
