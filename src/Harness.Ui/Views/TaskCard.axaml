<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:views="using:Harness.Ui.Views"
             x:Class="Harness.Ui.Views.TaskCard"
             x:DataType="vm:TaskCardViewModel">
  <!-- a card (TASK-0084): type and id left (the id opens the task's dialog), priority right on one line; the title below, wrapping; the blueprint's
       title on one line under it, cut with an ellipsis -->
  <Border Classes="card" AutomationProperties.Name="{Binding Id}">
    <StackPanel Spacing="6">
      <DockPanel>
        <TextBlock Name="Priority" DockPanel.Dock="Right" Classes="prio" VerticalAlignment="Center"
                   Text="{Binding Priority}" ToolTip.Tip="{Binding PriorityTip}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="type" Text="{Binding Type}" VerticalAlignment="Center" />
          <Button Name="OpenTask" Classes="tid" Content="{Binding Id}" CommandParameter="{Binding Id}"
                  Command="{Binding $parent[views:BoardView].((vm:BoardViewModel)DataContext).OpenTaskCommand}"
                  AutomationProperties.Name="{Binding Id, StringFormat='Open {0}'}" />
        </StackPanel>
      </DockPanel>
      <SelectableTextBlock Name="Title" Classes="title" Text="{Binding Title}" />
      <Border Name="BlueprintFrame" Classes="bpframe" IsVisible="{Binding HasBlueprint}"
              ToolTip.Tip="{Binding BlueprintId}">
        <TextBlock Text="{Binding BlueprintText}" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
