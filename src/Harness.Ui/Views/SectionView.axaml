<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:c="using:Harness.Ui.Controls"
             x:Class="Harness.Ui.Views.SectionView"
             x:DataType="vm:SectionViewModel">
  <!-- a section (app.js section()/mount()): its title and hint, then its content: the Body a view gives it, else the
       DataTemplate of its view model's type; the first load shows a loading line, a failure its error with Retry, a
       reload keeps the content -->
  <!-- a DockPanel, so a view that fills the window (the Board) gets the height left under the title -->
  <DockPanel Classes="section">
    <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{Binding Title}"
               IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
    <StackPanel DockPanel.Dock="Top" Name="Loading" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Loading}">
      <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" VerticalAlignment="Center" />
      <TextBlock Classes="muted" Text="Loading…" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Name="Failure" Classes="error" IsVisible="{Binding HasError}" Margin="0,0,0,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" Content="Retry" Command="{Binding RetryCommand}"
                Margin="12,0,0,0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
          <c:Icon Kind="status-ready" />
          <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl Name="BodyHost" IsVisible="{Binding HasContent}"
                    Opacity="{Binding Refreshing, Converter={x:Static c:Converters.Dimmed}}" />
  </DockPanel>
</UserControl>
