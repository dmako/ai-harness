<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:views="using:Harness.Ui.Views"
             x:Class="Harness.Ui.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Classes="label" Text="Sort by:" Margin="0,0,6,0" />
      <ComboBox Name="SortPicker" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}"
                AutomationProperties.Name="Sort by" Margin="0,0,16,4" />
      <TextBlock Classes="label" Text="Hide done tasks older than:" Margin="0,0,6,0" />
      <ComboBox Name="HideDonePicker" ItemsSource="{Binding HideDoneOptions}" SelectedItem="{Binding HideDone}"
                AutomationProperties.Name="Hide done tasks older than" Margin="0,0,16,4" />
      <TextBlock Classes="label" Text="Blueprint:" Margin="0,0,6,0" />
      <ComboBox Name="BlueprintPicker" ItemsSource="{Binding Blueprints}" SelectedItem="{Binding Blueprint}"
                AutomationProperties.Name="Blueprint" MaxWidth="320" Margin="0,0,0,4" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <!-- the board scrolls sideways inside itself, never the page; each column scrolls on its own -->
    <ScrollViewer Name="BoardScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Board" Focusable="True">
      <ItemsControl Name="Columns" ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BoardColumnViewModel">
            <Border Classes="column" AutomationProperties.Name="{Binding AccessibleName}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,10">
                  <Border Classes="colpill">
                    <TextBlock Classes="colhead" Text="{Binding Label}" />
                  </Border>
                  <TextBlock Classes="count" Text="{Binding Count}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="empty" Text="None" Margin="12,0,0,10"
                           IsVisible="{Binding IsEmpty}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Tasks}" Margin="8,0,8,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TaskCardViewModel">
                        <views:TaskCard />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
