<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:preview="using:Harness.Ui.Preview"
             xmlns:c="using:Harness.Ui.Controls"
             xmlns:views="using:Harness.Ui.Views"
             x:Class="Harness.Ui.Views.HomeView"
             x:DataType="vm:HomePage"
             d:DataContext="{x:Static preview:PreviewData.Home}">
  <!-- Home (app.js renderHome): what is on this machine at a glance, the workspaces' cards, the projects outside -->
  <StackPanel>
    <StackPanel Classes="phead">
      <TextBlock Classes="h2" Text="Home" />
      <TextBlock Classes="path" Text="Every repository on this machine that uses harness." />
    </StackPanel>
    <Border Name="VisitBanner" Classes="since" Margin="0,12,0,0" Background="{DynamicResource VisitGradient}" IsVisible="{Binding Activity.Since, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock Text="✦" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
        <TextBlock Name="SinceVisit" Grid.Column="1" Text="{Binding Activity.Since}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <ItemsControl Name="Tiles" ItemsSource="{Binding Tiles}" Margin="0,16,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:Tile">
          <Border Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <TextBlock Classes="value" Text="{Binding Value}" />
              <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Name="Columns" ColumnDefinitions="*,340" RowDefinitions="Auto">
    <StackPanel Name="MainColumn" Grid.Column="0" Margin="0,0,12,0">
    <StackPanel Classes="section">
      <DockPanel>
        <Button Name="NewWorkspace" DockPanel.Dock="Right" Classes="primary" Content="New workspace" AutomationProperties.Name="New workspace" Command="{Binding NewWorkspaceCommand}" />
        <StackPanel>
          <TextBlock Classes="h3" Text="Workspaces" />
          <TextBlock Classes="hint" Text="Repositories searched and reasoned about together." />
        </StackPanel>
      </DockPanel>
      <TextBlock Classes="empty" Text="No workspaces yet." IsVisible="{Binding !HasWorkspaces}" />
      <ItemsControl Name="WorkspaceCards" ItemsSource="{Binding WorkspaceCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavWorkspace">
            <Border Classes="card wscard" Padding="8">
              <StackPanel>
                <c:AppLink Classes="nav" Href="{Binding Href}" Margin="0" AutomationProperties.Name="{Binding Title}">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasWaiting}">
                      <TextBlock Text="{Binding Waiting}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Kind="workspace" />
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </c:AppLink>
                <TextBlock Classes="muted small" Text="No projects yet." Margin="8,4" IsVisible="{Binding !Members.Count}" />
                <ItemsControl ItemsSource="{Binding Members}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavProject">
                      <c:AppLink Classes="nav" Href="{Binding Href}" Margin="0" AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasWaiting}"><TextBlock Text="{Binding Waiting}" /></Border>
                          <c:Icon DockPanel.Dock="Right" Classes="state" Classes.g-ok="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=ok}"
                                  Classes.g-stale="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=stale}"
                                  Classes.g-warn="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=warn}"
                                  Classes.g-bad="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=bad}"
                                  Kind="{Binding StateIcon}" Margin="6,0" ToolTip.Tip="{Binding StateWords}" />
                          <Grid ColumnDefinitions="Auto,*"><Border Classes="project-mark" Classes.pc0="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=0}" Classes.pc1="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=1}" Classes.pc2="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=2}" Classes.pc3="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=3}" Classes.pc4="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=4}" Classes.pc5="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=5}" Classes.pc6="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=6}" Classes.pc7="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=7}"><TextBlock Text="{Binding Mark}" /></Border><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" /></Grid>
                        </DockPanel>
                        <Border Classes="pill" HorizontalAlignment="Left" IsVisible="{Binding HasLanguage}"><TextBlock Text="{Binding Language}" /></Border>
                        <TextBlock Classes="muted small" Text="Language: N/A" IsVisible="{Binding !HasLanguage}" />
                        <TextBlock Classes="muted small" Text="{Binding ContextLine}" />
                        <TextBlock Classes="muted small" Text="{Binding AgentLine}" />
                        </StackPanel>
                      </c:AppLink>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              <c:AppLink Classes="link" Href="{Binding MoreHref}" AutomationProperties.Name="{Binding MoreText}" IsVisible="{Binding HasMore}" Margin="8,4">
                  <TextBlock Text="{Binding MoreText}" />
                </c:AppLink>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Classes="section">
      <TextBlock Classes="h3" Text="{Binding OutsideTitle}" />
      <TextBlock Classes="empty" Text="{Binding OutsideEmpty}" IsVisible="{Binding OutsideEmpty, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ItemsControl Name="OutsideCards" ItemsSource="{Binding Outside}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavProject">
            <Border Classes="card" Padding="8" Width="240">
              <c:AppLink Classes="nav" Href="{Binding Href}" Margin="0" AutomationProperties.Name="{Binding Name}">
                <StackPanel Spacing="4">
                  <DockPanel>
                    <c:Icon DockPanel.Dock="Right" Classes="state" Classes.g-ok="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=ok}"
                            Classes.g-stale="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=stale}"
                            Classes.g-warn="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=warn}"
                            Classes.g-bad="{Binding StateKind, Converter={x:Static c:Converters.Is}, ConverterParameter=bad}"
                            Kind="{Binding StateIcon}" Margin="6,0" ToolTip.Tip="{Binding StateWords}" />
                    <Grid ColumnDefinitions="Auto,*"><Border Classes="project-mark" Classes.pc0="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=0}" Classes.pc1="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=1}" Classes.pc2="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=2}" Classes.pc3="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=3}" Classes.pc4="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=4}" Classes.pc5="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=5}" Classes.pc6="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=6}" Classes.pc7="{Binding MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=7}"><TextBlock Text="{Binding Mark}" /></Border><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" /></Grid>
                  </DockPanel>
                  <Border Classes="pill" HorizontalAlignment="Left" IsVisible="{Binding HasLanguage}"><TextBlock Text="{Binding Language}" /></Border>
                  <TextBlock Classes="muted small" Text="Language: N/A" IsVisible="{Binding !HasLanguage}" />
                  <TextBlock Classes="muted small" Text="{Binding ContextLine}" />
                  <TextBlock Classes="muted small" Text="{Binding AgentLine}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="badge" IsVisible="{Binding HasWaiting}"><TextBlock Text="{Binding Waiting}" /></Border>
                    <TextBlock Classes="muted small" Text="waiting" IsVisible="{Binding HasWaiting}" />
                    <TextBlock Classes="good small" Text="✓ nothing waiting" IsVisible="{Binding !HasWaiting}" />
                  </StackPanel>
                </StackPanel>
              </c:AppLink>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </StackPanel>
    <views:SectionView Name="ActivitySection" Grid.Column="1" DataContext="{Binding Activity}">
      <views:SectionView.Body>
        <StackPanel x:DataType="vm:ActivityViewModel" Spacing="8">
          <Border Name="ActivityChart" Classes="card" Padding="12,10">
            <StackPanel Spacing="6">
              <TextBlock Classes="small" Text="{Binding WeekSummary}" TextWrapping="Wrap" />
              <WrapPanel Name="ActivityLegend" ItemSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="4"><c:Swatch BrushKey="Accent" Size="8" VerticalAlignment="Center" /><TextBlock Classes="muted small" Text="agents' calls" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4"><c:Swatch BrushKey="Critical" Size="8" VerticalAlignment="Center" /><TextBlock Classes="muted small" Text="failed" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4"><c:Swatch BrushKey="CDecision" Size="6" VerticalAlignment="Center" /><TextBlock Classes="muted small" Text="a task or knowledge change" /></StackPanel>
              </WrapPanel>
              <c:DayBars Name="HomeDayBars" Days="{Binding Bars}" AutomationProperties.Name="{Binding WeekName}" />
              <ItemsControl Name="ActivityDays" ItemsSource="{Binding Week}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityDay">
                    <StackPanel>
                      <c:Dots Count="{Binding Changes}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                      <TextBlock Classes="muted small" Text="{Binding Label}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBlock Classes="empty" Text="No recent activity." IsVisible="{Binding Quiet}" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityRow">
                <c:AppLink Classes="row" Href="{Binding Href}" AutomationProperties.Name="{Binding Head}">
                  <StackPanel><TextBlock Text="{Binding Head}" TextWrapping="Wrap" /><TextBlock Classes="muted small" Text="{Binding Meta}" TextWrapping="Wrap" /><TextBlock Classes="muted small" Text="{Binding When}" /></StackPanel>
                </c:AppLink>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="ghost small" Content="{Binding MoreLabel}" AutomationProperties.Name="{Binding MoreLabel}" Command="{Binding ShowAllCommand}" IsVisible="{Binding HasMore}" />
        </StackPanel>
      </views:SectionView.Body>
    </views:SectionView>
    </Grid>
  </StackPanel>
</UserControl>
