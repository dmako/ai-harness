<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:views="using:Harness.Ui.Views"
             xmlns:c="using:Harness.Ui.Controls"
             x:Class="Harness.Ui.Views.MainView"
             x:DataType="vm:MainViewModel"
             Classes="page">
  <!-- the page frame: the sidebar (beside the page when wide, over it when narrow), the top bar, and the page the
       address names; toasts and the open dialog above everything -->
  <Panel>
    <Grid Name="Frame" ColumnDefinitions="Auto,*">
      <Border Name="Sidebar" Classes="sidebar" Grid.Column="0" ZIndex="1">
        <views:Sidebar />
      </Border>
      <DockPanel Grid.Column="1">
        <Border Classes="topbar" DockPanel.Dock="Top">
          <DockPanel>
            <Button Name="Menu" DockPanel.Dock="Left" Classes="ghost" Content="Projects" Margin="0,0,12,0"
                    AutomationProperties.Name="Show projects" IsVisible="False" />
            <TextBlock DockPanel.Dock="Right" Classes="live" Text="{Binding Services.Live.State, StringFormat='● {0}'}" />
            <TextBlock Classes="brand" Text="harness" />
          </DockPanel>
        </Border>
        <TextBlock Classes="error" DockPanel.Dock="Top" Margin="16,8,16,0" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- the page scrolls up and down only when the window is shorter than PageMinHeight; otherwise the page is
             exactly the window's height and a view that scrolls (the Board's columns) scrolls inside itself -->
        <ScrollViewer Name="PageScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ContentControl Name="Page" Content="{Binding Page}" Margin="16,12,16,16" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
    <views:ToastLayer DataContext="{Binding Services.Toasts}" />
    <views:DialogLayer DataContext="{Binding Services.Dialogs}" />
  </Panel>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:HomePage">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProjectPage">
      <views:ProjectPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspacePage">
      <views:WorkspacePageView />
    </DataTemplate>
    <DataTemplate DataType="vm:BoardViewModel">
      <views:BoardView Name="Board" />
    </DataTemplate>
    <DataTemplate DataType="vm:OverviewViewModel">
      <views:OverviewView Name="Overview" />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkViewModel">
      <views:WorkView Name="Work" />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskDialog">
      <views:TaskDialogView />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskFormDialog">
      <views:TaskFormView />
    </DataTemplate>
    <DataTemplate DataType="vm:BlueprintFormDialog">
      <views:BlueprintFormView />
    </DataTemplate>
    <DataTemplate DataType="vm:RemoveBlueprintDialog">
      <views:RemoveBlueprintView />
    </DataTemplate>
    <DataTemplate DataType="vm:ArchApproveDialog">
      <views:ArchApproveView />
    </DataTemplate>
    <DataTemplate DataType="vm:RejectDialog">
      <views:RejectView />
    </DataTemplate>
    <DataTemplate DataType="vm:HealthViewModel">
      <views:HealthView Name="Health" />
    </DataTemplate>
    <DataTemplate DataType="vm:FixPreviewDialog">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Head}" TextWrapping="Wrap" />
        <Border Classes="inset">
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Name="FixDiff" Classes="mono" Text="{Binding Diff}" />
          </ScrollViewer>
        </Border>
        <TextBlock Classes="hint" Text="{x:Static vm:FixPreviewDialog.Note}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MessagePage">
      <StackPanel Spacing="8">
        <Border Classes="error"><TextBlock Text="{Binding Message}" /></Border>
        <c:AppLink Classes="link" Href="#/" Content="Home" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:PlaceholderPage">
      <StackPanel Classes="section" Margin="0">
        <TextBlock Classes="h3" Text="{Binding Title}" />
        <TextBlock Classes="hint" Text="{Binding Note}" />
        <HyperlinkButton Content="Open it in the current harness ui" NavigateUri="{Binding Current}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:UnreadableBody">
      <StackPanel Spacing="8">
        <TextBlock Classes="empty" Text="{Binding Message}" />
        <c:AppLink Classes="link" Href="{Binding HealthHref}" Content="See Health" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:RenameDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Display name" />
        <TextBox Name="DisplayField" Text="{Binding Display}" PlaceholderText="{Binding DisplayHint}" MaxLength="80"
                 AutomationProperties.Name="Display name" />
        <TextBlock Classes="label" Text="Short name" Margin="0,8,0,0" />
        <TextBox Name="ShortField" Classes="mono" Text="{Binding Short}" PlaceholderText="{Binding ShortHint}"
                 AutomationProperties.Name="Short name" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
