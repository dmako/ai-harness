<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:views="using:Harness.Ui.Views"
             xmlns:c="using:Harness.Ui.Controls"
             xmlns:api="using:Harness.Ui.Api"
             x:Class="Harness.Ui.Views.MainView"
             x:DataType="vm:MainViewModel"
             Classes="page">
  <!-- the page frame: the sidebar (beside the page when wide, over it when narrow), the top bar, and the page the
       address names; toasts and the open dialog above everything -->
  <Panel>
    <Grid Name="Frame" ColumnDefinitions="Auto,*">
      <Border Name="Sidebar" Classes="sidebar" Grid.Column="0" ZIndex="1">
        <views:Sidebar />
      </Border>
      <DockPanel Grid.Column="1">
        <Border Classes="topbar" DockPanel.Dock="Top">
          <DockPanel>
            <Button Name="Menu" DockPanel.Dock="Left" Classes="ghost" Content="Projects" Margin="0,0,12,0"
                    AutomationProperties.Name="Show projects" IsVisible="False" />
            <TextBlock DockPanel.Dock="Right" Classes="live" Text="{Binding Services.Live.State, StringFormat='● {0}'}" />
            <TextBlock Classes="brand" Text="harness" />
          </DockPanel>
        </Border>
        <TextBlock Classes="error" DockPanel.Dock="Top" Margin="16,8,16,0" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- the page scrolls up and down only when the window is shorter than PageMinHeight; otherwise the page is
             exactly the window's height and a view that scrolls (the Board's columns) scrolls inside itself -->
        <ScrollViewer Name="PageScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ContentControl Name="Page" Content="{Binding Page}" Margin="16,12,16,16" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
    <views:ToastLayer DataContext="{Binding Services.Toasts}" />
    <views:DialogLayer DataContext="{Binding Services.Dialogs}" />
  </Panel>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:HomePage">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProjectPage">
      <views:ProjectPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspacePage">
      <views:WorkspacePageView />
    </DataTemplate>
    <DataTemplate DataType="vm:BoardViewModel">
      <views:BoardView Name="Board" />
    </DataTemplate>
    <DataTemplate DataType="vm:OverviewViewModel">
      <views:OverviewView Name="Overview" />
    </DataTemplate>
    <DataTemplate DataType="vm:MachinePage">
      <views:MachineView Name="Machine" />
    </DataTemplate>
    <DataTemplate DataType="vm:SearchPage">
      <views:SearchView Name="Search" />
    </DataTemplate>
    <DataTemplate DataType="vm:DocsPage">
      <views:DocsView Name="Docs" />
    </DataTemplate>
    <DataTemplate DataType="vm:ScmFormDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Name" />
          <TextBox Name="ScmName" Text="{Binding Name}" AutomationProperties.Name="Name" />
          <TextBlock Classes="muted small" Text="How projects and the CLI refer to it: letters, digits, '-', '_' or '.'." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Type" />
          <ComboBox Name="ScmType" ItemsSource="{x:Static vm:ScmFormDialog.Types}" SelectedItem="{Binding Type}" PlaceholderText="Choose a type"
                    MinWidth="180" AutomationProperties.Name="Type" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="URL" />
          <TextBox Name="ScmUrl" Text="{Binding Address}" PlaceholderText="https://gitlab.example.com" AutomationProperties.Name="URL" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="The server's base address; an instance under a path keeps it (https://host/gitlab). GitHub: https://github.com or the Enterprise Server's address." />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Token" />
          <TextBox Name="ScmToken" Text="{Binding Token}" PasswordChar="•" PlaceholderText="{Binding TokenPlaceholder}" AutomationProperties.Name="Token" />
          <TextBlock Classes="muted small" Text="{Binding TokenHint}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Aliases" />
          <ItemsControl ItemsSource="{Binding Aliases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LineItem">
                <DockPanel Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Classes="icon" AutomationProperties.Name="Remove alias"
                          Command="{Binding $parent[ItemsControl].((vm:ScmFormDialog)DataContext).RemoveAliasCommand}" CommandParameter="{Binding}">
                    <c:Icon Kind="trash" />
                  </Button>
                  <TextBox Text="{Binding Text}" PlaceholderText="https://git-alias.example.com or ssh-alias" AutomationProperties.Name="Alias" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="ghost small" Command="{Binding AddAliasCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4"><c:Icon Kind="plus" /><TextBlock Text="Add alias" /></StackPanel>
          </Button>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Other host names or base URLs this server's repositories are cloned from. They only match remotes; API calls use the URL above." />
        </StackPanel>
        <WrapPanel ItemSpacing="8">
          <Button Name="ScmTest" Classes="ghost" Content="Test connection" Command="{Binding TestCommand}" />
          <TextBlock Classes="small" Text="{Binding TestLine}" TextWrapping="Wrap" VerticalAlignment="Center"
                     IsVisible="{Binding TestLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:KnowledgeViewModel">
      <views:KnowledgeView Name="Knowledge" />
    </DataTemplate>
    <DataTemplate DataType="vm:LevelKnowledgeViewModel">
      <views:LevelKnowledgeView Name="LevelKnowledge" />
    </DataTemplate>
    <DataTemplate DataType="vm:UserKnowledgePage">
      <StackPanel>
        <StackPanel Classes="phead">
          <TextBlock Classes="h2" Text="Your knowledge" />
          <TextBlock Classes="path" Text="{x:Static vm:UserKnowledgePage.Intro}" />
        </StackPanel>
        <views:LevelKnowledgeView DataContext="{Binding Knowledge}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryChangeDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field" IsVisible="{Binding Correcting}">
          <TextBlock Classes="label" Text="Corrected statement" />
          <TextBox Name="ContentField" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                   AutomationProperties.Name="Corrected statement" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="{Binding ReasonLabel}" />
          <TextBox Name="ReasonField" Text="{Binding Reason}" AutomationProperties.Name="{Binding ReasonLabel}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:PromoteDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Apply to" />
        <ComboBox Name="PromoteTo" ItemsSource="{Binding Targets}" SelectedItem="{Binding To}" MinWidth="220" AutomationProperties.Name="Apply to" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryAddDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Type" />
          <ComboBox Name="TypeField" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Type" />
          <TextBlock Classes="muted small" Text="{Binding Type.Example}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{Binding Type.Reach}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Statement" />
          <TextBox Name="StatementField" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                   AutomationProperties.Name="Statement" />
        </StackPanel>
        <StackPanel Classes="field" IsVisible="{Binding AsksScope}">
          <TextBlock Classes="label" Text="Applies to (project, or path:src/ui, subsystem:sync, branch:main)" TextWrapping="Wrap" />
          <TextBox Name="ScopeField" Text="{Binding Scope}" AutomationProperties.Name="Applies to" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Source (optional)" />
          <TextBox Name="SourceField" Text="{Binding SourceRef}" AutomationProperties.Name="Source" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:ProposalEditDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Statement" />
        <TextBox Name="StatementField" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                 AutomationProperties.Name="Statement" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:SimilarDecisionDialog">
      <ItemsControl ItemsSource="{Binding Similar}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="api:SimilarMemory">
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Replace this one" Margin="8,0,0,0" VerticalAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:SimilarDecisionDialog)DataContext).ReplaceCommand}" CommandParameter="{Binding}" />
              <StackPanel>
                <SelectableTextBlock Text="{Binding Memory.Content}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small" Text="{Binding Memory.Id}" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryRejectDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Note (optional)" />
        <TextBox Name="NoteField" Text="{Binding Note}" AutomationProperties.Name="Note" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:WorkViewModel">
      <views:WorkView Name="Work" />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskDialog">
      <views:TaskDialogView />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskFormDialog">
      <views:TaskFormView />
    </DataTemplate>
    <DataTemplate DataType="vm:BlueprintFormDialog">
      <views:BlueprintFormView />
    </DataTemplate>
    <DataTemplate DataType="vm:RemoveBlueprintDialog">
      <views:RemoveBlueprintView />
    </DataTemplate>
    <DataTemplate DataType="vm:ArchApproveDialog">
      <views:ArchApproveView />
    </DataTemplate>
    <DataTemplate DataType="vm:RejectDialog">
      <views:RejectView />
    </DataTemplate>
    <DataTemplate DataType="vm:HealthViewModel">
      <views:HealthView Name="Health" />
    </DataTemplate>
    <DataTemplate DataType="vm:FixPreviewDialog">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Head}" TextWrapping="Wrap" />
        <Border Classes="inset">
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Name="FixDiff" Classes="mono" Text="{Binding Diff}" />
          </ScrollViewer>
        </Border>
        <TextBlock Classes="hint" Text="{x:Static vm:FixPreviewDialog.Note}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MessagePage">
      <StackPanel Spacing="8">
        <Border Classes="error"><TextBlock Text="{Binding Message}" /></Border>
        <c:AppLink Classes="link" Href="#/" Content="Home" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:PlaceholderPage">
      <StackPanel Classes="section" Margin="0">
        <TextBlock Classes="h3" Text="{Binding Title}" />
        <TextBlock Classes="hint" Text="{Binding Note}" />
        <HyperlinkButton Content="Open it in the current harness ui" NavigateUri="{Binding Current}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:UnreadableBody">
      <StackPanel Spacing="8">
        <TextBlock Classes="empty" Text="{Binding Message}" />
        <c:AppLink Classes="link" Href="{Binding HealthHref}" Content="See Health" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:RenameDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Display name" />
        <TextBox Name="DisplayField" Text="{Binding Display}" PlaceholderText="{Binding DisplayHint}" MaxLength="80"
                 AutomationProperties.Name="Display name" />
        <TextBlock Classes="label" Text="Short name" Margin="0,8,0,0" />
        <TextBox Name="ShortField" Classes="mono" Text="{Binding Short}" PlaceholderText="{Binding ShortHint}"
                 AutomationProperties.Name="Short name" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
