<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:preview="using:Harness.Ui.Preview"
             xmlns:views="using:Harness.Ui.Views"
             xmlns:c="using:Harness.Ui.Controls"
             xmlns:api="using:Harness.Ui.Api"
             x:Class="Harness.Ui.Views.MainView"
             x:DataType="vm:MainViewModel"
             Classes="page"
             d:DataContext="{x:Static preview:PreviewData.Main}">
  <!-- the page frame: the sidebar (beside the page when wide, over it when narrow), the top bar, and the page the
       address names; toasts and the open dialog above everything -->
  <UserControl.Styles>
    <Style Selector="TextBlock.find-hit">
      <Setter Property="Background" Value="{DynamicResource AccentWash}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="TextBlock.find-current">
      <Setter Property="Background" Value="{DynamicResource Gold}" />
      <Setter Property="Foreground" Value="{DynamicResource OnGold}" />
    </Style>
    <Style Selector="TextBox.find-hit">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox.find-current">
      <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Grid RowDefinitions="Auto,*">
      <Border Name="Header" Classes="topbar" Grid.Row="0">
        <DockPanel>
          <ToggleButton Name="Menu" DockPanel.Dock="Left" Content="☰" Margin="0,0,12,0"
                        AutomationProperties.Name="Navigation" ToolTip.Tip="Toggle navigation" />
          <TextBlock Name="LiveState" DockPanel.Dock="Right" Classes="live"
                     Classes.connected="{Binding Services.Live.IsConnected}"
                     Classes.offline="{Binding Services.Live.IsOffline}"
                     Text="{Binding Services.Live.State, StringFormat='● {0}'}"
                     AutomationProperties.Name="{Binding Services.Live.State, StringFormat='Connection: {0}'}" />
          <Button Name="ThemeButton" DockPanel.Dock="Right" Classes="ghost" Content="◐" Margin="8,0"
                  AutomationProperties.Name="Theme" ToolTip.Tip="Theme">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="System" Command="{Binding SelectThemeCommand}" CommandParameter="system" />
                <MenuItem Header="Light" Command="{Binding SelectThemeCommand}" CommandParameter="light" />
                <MenuItem Header="Dark" Command="{Binding SelectThemeCommand}" CommandParameter="dark" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBox Name="OpenFind" DockPanel.Dock="Right" Width="110" PlaceholderText="Find…"
                   AutomationProperties.Name="Find in this view" />
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal">
              <Image Name="BrandIcon" Source="avares://Harness.Ui/Assets/logo.png" Width="24" Height="24"
                     Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Classes="brand" Text="harness" Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Classes="brandSeparator" Text="|" Margin="0,0,12,0" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Name="Breadcrumbs" ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:Breadcrumb">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Classes="muted" Text="›" VerticalAlignment="Center" IsVisible="{Binding !IsHome}" />
                      <c:AppLink Classes="link" Href="{Binding Href}" AutomationProperties.Name="{Binding Label}">
                        <Panel>
                          <c:Icon Kind="home" IsVisible="{Binding IsHome}" />
                          <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsHome}"
                                     TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </Panel>
                      </c:AppLink>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
      <Grid Name="Frame" Grid.Row="1" ColumnDefinitions="Auto,*">
        <Border Name="Sidebar" Classes="sidebar" Grid.Column="0" ZIndex="1">
          <views:Sidebar />
        </Border>
        <DockPanel Grid.Column="1">
          <TextBlock Classes="error" DockPanel.Dock="Top" Margin="16,8,16,0" Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <!-- the page scrolls up and down only when the window is shorter than PageMinHeight; otherwise the page is
               exactly the window's height and a view that scrolls (the Board's columns) scrolls inside itself -->
          <ScrollViewer Name="PageScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ContentControl Name="Page" Content="{Binding Page}" Margin="16,12,16,16" />
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>
    <views:ToastLayer DataContext="{Binding Services.Toasts}" />
    <views:DialogLayer Name="Dialogs" DataContext="{Binding Services.Dialogs}" />
    <Border Name="FindBar" Classes="inset" Margin="16,8" IsVisible="False" ZIndex="10"
            HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="540">
      <StackPanel Spacing="4">
        <WrapPanel ItemSpacing="6" LineSpacing="6">
          <TextBox Name="FindInput" Width="180" PlaceholderText="Find in this view"
                   AutomationProperties.Name="Find in this view" />
          <TextBlock Name="FindCount" VerticalAlignment="Center" />
          <Button Name="FindPrevious" Content="Previous" AutomationProperties.Name="Previous match" />
          <Button Name="FindNext" Content="Next" AutomationProperties.Name="Next match" />
          <Button Name="FindClose" Content="Close" AutomationProperties.Name="Close find" />
        </WrapPanel>
        <TextBlock Name="FindPreview" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Panel>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:HomePage">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProjectPage">
      <views:ProjectPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspacePage">
      <views:WorkspacePageView />
    </DataTemplate>
    <DataTemplate DataType="vm:BoardViewModel">
      <views:BoardView Name="Board" />
    </DataTemplate>
    <DataTemplate DataType="vm:OverviewViewModel">
      <views:OverviewView Name="Overview" />
    </DataTemplate>
    <DataTemplate DataType="vm:AgentsViewModel">
      <views:AgentsView Name="Agents" />
    </DataTemplate>
    <DataTemplate DataType="vm:MachinePage">
      <views:MachineView Name="Machine" />
    </DataTemplate>
    <DataTemplate DataType="vm:SearchPage">
      <views:SearchView Name="Search" />
    </DataTemplate>
    <DataTemplate DataType="vm:DocsPage">
      <views:DocsView Name="Docs" />
    </DataTemplate>
    <DataTemplate DataType="vm:ScmFormDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Name" />
          <TextBox Name="ScmName" Text="{Binding Name}" AutomationProperties.Name="Name" />
          <TextBlock Classes="muted small"
                     Text="How projects and the CLI refer to it: letters, digits, '-', '_' or '.'."
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Type" />
          <ComboBox Name="ScmType" ItemsSource="{x:Static vm:ScmFormDialog.Types}" SelectedItem="{Binding Type}"
                    PlaceholderText="Choose a type"
                    MinWidth="180" AutomationProperties.Name="Type" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="URL" />
          <TextBox Name="ScmUrl" Text="{Binding Address}" PlaceholderText="https://gitlab.example.com"
                   AutomationProperties.Name="URL" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="The server's base address; an instance under a path keeps it (https://host/gitlab). GitHub: https://github.com or the Enterprise Server's address." />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Token" />
          <TextBox Name="ScmToken" Text="{Binding Token}" PasswordChar="•" PlaceholderText="{Binding TokenPlaceholder}"
                   AutomationProperties.Name="Token" />
          <TextBlock Classes="muted small" Text="{Binding TokenHint}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Aliases" />
          <ItemsControl ItemsSource="{Binding Aliases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LineItem">
                <DockPanel Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Classes="icon" AutomationProperties.Name="Remove alias"
                          Command="{Binding $parent[ItemsControl].((vm:ScmFormDialog)DataContext).RemoveAliasCommand}"
                          CommandParameter="{Binding}">
                    <c:Icon Kind="trash" />
                  </Button>
                  <TextBox Text="{Binding Text}" PlaceholderText="https://git-alias.example.com or ssh-alias"
                           AutomationProperties.Name="Alias" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="ghost small" AutomationProperties.Name="Add alias" Command="{Binding AddAliasCommand}"
                  HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:Icon Kind="plus" /><TextBlock Text="Add alias" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Other host names or base URLs this server's repositories are cloned from. They only match remotes; API calls use the URL above." />
        </StackPanel>
        <WrapPanel ItemSpacing="8">
          <Button Name="ScmTest" Classes="ghost" Content="Test connection" AutomationProperties.Name="Test connection"
                  Command="{Binding TestCommand}" />
          <TextBlock Classes="small" Text="{Binding TestLine}" TextWrapping="Wrap" VerticalAlignment="Center"
                     IsVisible="{Binding TestLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:KnowledgeViewModel">
      <views:KnowledgeView Name="Knowledge" />
    </DataTemplate>
    <DataTemplate DataType="vm:LevelKnowledgeViewModel">
      <views:LevelKnowledgeView Name="LevelKnowledge" />
    </DataTemplate>
    <DataTemplate DataType="vm:UserKnowledgePage">
      <StackPanel>
        <StackPanel Classes="phead">
          <TextBlock Classes="h2" Text="Your knowledge" />
          <TextBlock Classes="path" Text="{x:Static vm:UserKnowledgePage.Intro}" />
        </StackPanel>
        <views:LevelKnowledgeView DataContext="{Binding Knowledge}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryChangeDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field" IsVisible="{Binding Correcting}">
          <TextBlock Classes="label" Text="Corrected statement" />
          <TextBox Name="ContentField" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                   AutomationProperties.Name="Corrected statement" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="{Binding ReasonLabel}" />
          <TextBox Name="ReasonField" Text="{Binding Reason}" AutomationProperties.Name="{Binding ReasonLabel}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:PromoteDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Apply to" />
        <ComboBox Name="PromoteTo" ItemsSource="{Binding Targets}" SelectedItem="{Binding To}" MinWidth="220"
                  AutomationProperties.Name="Apply to" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryAddDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Type" />
          <ComboBox Name="TypeField" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Type" />
          <TextBlock Classes="muted small" Text="{Binding Type.Example}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{Binding Type.Reach}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Statement" />
          <TextBox Name="StatementField" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="72"
                   AutomationProperties.Name="Statement" />
        </StackPanel>
        <StackPanel Classes="field" IsVisible="{Binding AsksScope}">
          <TextBlock Classes="label" Text="Applies to (project, or path:src/ui, subsystem:sync, branch:main)"
                     TextWrapping="Wrap" />
          <TextBox Name="ScopeField" Text="{Binding Scope}" AutomationProperties.Name="Applies to" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Source (optional)" />
          <TextBox Name="SourceField" Text="{Binding SourceRef}" AutomationProperties.Name="Source" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:ProposalEditDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Statement" />
        <TextBox Name="StatementField" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                 AutomationProperties.Name="Statement" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:SimilarDecisionDialog">
      <ItemsControl ItemsSource="{Binding Similar}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="api:SimilarMemory">
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Replace this one" AutomationProperties.Name="Replace this one"
                      Margin="8,0,0,0" VerticalAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:SimilarDecisionDialog)DataContext).ReplaceCommand}"
                      CommandParameter="{Binding}" />
              <StackPanel>
                <SelectableTextBlock Text="{Binding Memory.Content}" TextWrapping="Wrap" />
                <SelectableTextBlock Classes="muted small" Text="{Binding Memory.Id}" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryRejectDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Note (optional)" />
        <TextBox Name="NoteField" Text="{Binding Note}" AutomationProperties.Name="Note" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:WorkViewModel">
      <views:WorkView Name="Work" />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskDialog">
      <views:TaskDialogView />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskFormDialog">
      <views:TaskFormView />
    </DataTemplate>
    <DataTemplate DataType="vm:BlueprintFormDialog">
      <views:BlueprintFormView />
    </DataTemplate>
    <DataTemplate DataType="vm:RemoveBlueprintDialog">
      <views:RemoveBlueprintView />
    </DataTemplate>
    <DataTemplate DataType="vm:ArchApproveDialog">
      <views:ArchApproveView />
    </DataTemplate>
    <DataTemplate DataType="vm:RejectDialog">
      <views:RejectView />
    </DataTemplate>
    <DataTemplate DataType="vm:ArchitectureViewModel">
      <views:ArchitectureView Name="Architecture" />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceOverviewViewModel">
      <views:WorkspaceOverviewView Name="WorkspaceOverview" />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceArchitectureViewModel">
      <views:WorkspaceArchitectureView Name="WorkspaceArchitecture" />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceIssuesViewModel">
      <views:WorkspaceIssuesView Name="WorkspaceIssues" />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceMembersViewModel">
      <views:WorkspaceMembersView Name="WorkspaceMembers" />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceFormDialog">
      <StackPanel Spacing="10">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Display name" />
          <TextBox Name="WorkspaceTitle" Text="{Binding DisplayTitle}" PlaceholderText="e.g. Company services"
                   MaxLength="80" AutomationProperties.Name="Display name" />
          <TextBlock Classes="hint" Text="Any text, shown in the sidebar and on its page (optional)."
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="Short name" />
          <TextBox Name="WorkspaceName" Classes="mono" Text="{Binding ShortName}" PlaceholderText="e.g. company"
                   AutomationProperties.Name="Short name" />
          <TextBlock Classes="hint"
                     Text="What agents and commands use: workspace:&lt;short name&gt;. Follows the display name until you edit it."
                     TextWrapping="Wrap" />
          <TextBlock Classes="muted small mono" Text="{Binding Preview}" />
        </StackPanel>
        <TextBlock Classes="label" Text="Projects (now, or none and add them later)" />
        <ContentControl Content="{Binding Picker}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:AddProjectsDialog">
      <ContentControl Content="{Binding Picker}" />
    </DataTemplate>
    <DataTemplate DataType="vm:ProjectPicker">
      <StackPanel Spacing="8">
        <WrapPanel ItemSpacing="6" LineSpacing="6">
          <TextBox Name="PickFilter" Text="{Binding Query}" PlaceholderText="Filter by name or folder" Width="220"
                   AutomationProperties.Name="Filter projects" />
          <Button Classes="ghost small" Content="Choose all shown" AutomationProperties.Name="Choose all shown"
                  Command="{Binding ChooseShownCommand}" />
          <Button Classes="ghost small" Content="None" AutomationProperties.Name="None"
                  Command="{Binding ChooseNoneCommand}" />
          <TextBlock Classes="muted small" Text="{Binding ChosenLine}" VerticalAlignment="Center" />
        </WrapPanel>
        <Border Classes="inset">
          <ScrollViewer MaxHeight="260">
            <StackPanel>
              <TextBlock Classes="muted small" Text="No project matches." IsVisible="{Binding IsEmpty}" />
              <ItemsControl Name="PickRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PickRow">
                    <CheckBox IsChecked="{Binding Chosen}" AutomationProperties.Name="{Binding Name}">
                      <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Classes="project-mark compact"
                                  Classes.pc0="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=0}"
                                  Classes.pc1="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=1}"
                                  Classes.pc2="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=2}"
                                  Classes.pc3="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=3}"
                                  Classes.pc4="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=4}"
                                  Classes.pc5="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=5}"
                                  Classes.pc6="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=6}"
                                  Classes.pc7="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=7}">
                            <TextBlock Text="{Binding Project.Mark}" />
                          </Border>
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        </StackPanel>
                        <TextBlock Classes="muted small mono" Text="{Binding Root}" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock Classes="label" Text="Or choose those under a folder" />
        <WrapPanel ItemSpacing="6" LineSpacing="6">
          <TextBox Name="PickFolder" Classes="mono" Text="{Binding Folder}" PlaceholderText="/path/to/folder"
                   Width="300" AutomationProperties.Name="Folder" />
          <Button Classes="small" Content="Find" AutomationProperties.Name="Find" Command="{Binding FindCommand}" />
        </WrapPanel>
        <TextBlock Classes="muted small" Text="{Binding FolderMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding FolderMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:FindingTaskDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="The member it belongs to" />
        <ComboBox Name="TaskMember" ItemsSource="{Binding Members}" SelectedItem="{Binding Member}" MinWidth="240"
                  AutomationProperties.Name="The member it belongs to">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MemberChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="hint" Text="{x:Static vm:FindingTaskDialog.Note}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:FindingMarkDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Why it is intended" />
        <TextBox Name="ReasonField" Text="{Binding Reason}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                 AutomationProperties.Name="Why it is intended" />
        <TextBlock Classes="hint" Text="{x:Static vm:FindingMarkDialog.Note}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:HealthViewModel">
      <views:HealthView Name="Health" />
    </DataTemplate>
    <DataTemplate DataType="vm:FixPreviewDialog">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Head}" TextWrapping="Wrap" />
        <Border Classes="inset">
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Name="FixDiff" Classes="mono" Text="{Binding Diff}" />
          </ScrollViewer>
        </Border>
        <TextBlock Classes="hint" Text="{x:Static vm:FixPreviewDialog.Note}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:MessagePage">
      <StackPanel Spacing="8">
        <Border Classes="error">
          <TextBlock Text="{Binding Message}" />
        </Border>
        <c:AppLink Classes="link" Href="#/" Content="Home" AutomationProperties.Name="Home" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:PlaceholderPage">
      <StackPanel Classes="section" Margin="0">
        <TextBlock Classes="h3" Text="{Binding Title}" />
        <TextBlock Classes="hint" Text="{Binding Note}" />
        <HyperlinkButton Content="Open it in the current harness ui"
                         AutomationProperties.Name="Open it in the current harness ui"
                         NavigateUri="{Binding Current}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:UnreadableBody">
      <StackPanel Spacing="8">
        <TextBlock Classes="empty" Text="{Binding Message}" />
        <c:AppLink Classes="link" Href="{Binding HealthHref}" Content="See Health"
                   AutomationProperties.Name="See Health" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:RenameDialog">
      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="Display name" />
        <TextBox Name="DisplayField" Text="{Binding Display}" PlaceholderText="{Binding DisplayHint}" MaxLength="80"
                 AutomationProperties.Name="Display name" />
        <TextBlock Classes="label" Text="Short name" Margin="0,8,0,0" />
        <TextBox Name="ShortField" Classes="mono" Text="{Binding Short}" PlaceholderText="{Binding ShortHint}"
                 AutomationProperties.Name="Short name" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
