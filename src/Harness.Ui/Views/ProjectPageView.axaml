<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Harness.Ui.ViewModels"
             xmlns:preview="using:Harness.Ui.Preview"
             xmlns:c="using:Harness.Ui.Controls"
             x:Class="Harness.Ui.Views.ProjectPageView"
             x:DataType="vm:ProjectPage"
             d:DataContext="{x:Static preview:PreviewData.ProjectPage}">
  <!-- a project's page (app.js projectHead): its name, rename, the short name to copy, where it lives, what it is in,
       what changed; the view tabs with what waits; then the view -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Classes="phead">
      <WrapPanel ItemSpacing="10" LineSpacing="4">
        <Border Classes="project-mark" Classes.pc0="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=0}" Classes.pc1="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=1}" Classes.pc2="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=2}" Classes.pc3="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=3}" Classes.pc4="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=4}" Classes.pc5="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=5}" Classes.pc6="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=6}" Classes.pc7="{Binding Project.MarkColor, Converter={x:Static c:Converters.Is}, ConverterParameter=7}"><TextBlock Text="{Binding Project.Mark}" /></Border>
        <TextBlock Classes="h2" Text="{Binding Project.DisplayName}" />
        <Button Name="Rename" Classes="icon" Command="{Binding RenameCommand}" ToolTip.Tip="Rename: change the display name or the short name"
                AutomationProperties.Name="Rename this project" VerticalAlignment="Center">
          <c:Icon Kind="edit" />
        </Button>
        <c:AppLink Classes="health-badge" Href="{Binding HealthHref}" AutomationProperties.Name="{Binding Project.Live.HealthWords}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="●" Classes="health-dot" Classes.g-ok="{Binding Project.Live.HealthKind, Converter={x:Static c:Converters.Is}, ConverterParameter=ok}"
                       Classes.g-warn="{Binding Project.Live.HealthKind, Converter={x:Static c:Converters.Is}, ConverterParameter=warn}"
                       Classes.g-bad="{Binding Project.Live.HealthKind, Converter={x:Static c:Converters.Is}, ConverterParameter=bad}" />
            <TextBlock Text="{Binding Project.Live.HealthWords}" />
          </StackPanel>
        </c:AppLink>
      </WrapPanel>
      <WrapPanel ItemSpacing="12" LineSpacing="2">
        <SelectableTextBlock Classes="mono path" Text="{Binding Project.Root}" />
        <TextBlock Classes="muted small" Text="{Binding ShortNote}" IsVisible="{Binding ShortNote, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding Project.Workspaces}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <c:AppLink Classes="link" Href="{Binding Converter={x:Static c:Converters.WorkspaceHref}}" AutomationProperties.Name="{Binding StringFormat='Open workspace {0}'}" ToolTip.Tip="Open this workspace">
                <TextBlock Text="{Binding StringFormat='in {0}'}" />
              </c:AppLink>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
      <WrapPanel ItemSpacing="10">
        <Border Name="LanguageMark" Classes="language-mark" VerticalAlignment="Center" IsVisible="{Binding Stack, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Text="{Binding Stack.Mark}" /></Border>
        <TextBlock Name="LanguageBadge" Classes="facts" Text="{Binding Stack.Badge}" VerticalAlignment="Center" />
        <TextBlock Classes="facts" Text="{Binding Facts}" IsVisible="{Binding HasFacts}" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Classes="facts" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Classes="tabs">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl Name="Tabs" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabItem">
              <c:AppLink Classes="tablink" Classes.selected="{Binding Selected}" Href="{Binding Href}"
                         AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Label}" />
                  <Border Classes="badge" IsVisible="{Binding HasBadge}"><TextBlock Text="{Binding Badge}" /></Border>
                </StackPanel>
              </c:AppLink>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <ContentControl Name="Body" Content="{Binding Body}" />
  </DockPanel>
</UserControl>
