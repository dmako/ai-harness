        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "source_ref": {
              "type": "string"
            },
            "proposed_by": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "supersedes": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "decided_by": {
              "type": "string"
            },
            "decision_note": {
              "type": "string"
            },
            "memory_id": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "content",
            "scope",
            "source_ref",
            "proposed_by",
            "status",
            "created_at"
          ],
          "additionalProperties": false
        }
      },
      "proposal_errors": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "string"
        }
      },
      "hint": {
        "type": "string"
      }
    },
    "required": [
      "task"
    ],
    "additionalProperties": false
  }
}
