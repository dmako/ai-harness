{
  "description": "Complete a claimed task, normally from review (completing without it is recorded as review_skipped). Report EVERY acceptance criterion (pass, or n/a with an explanation) and the validation commands you ran. Rejected if anything is missing or failing; nothing changes then.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "claim_token": {
        "type": "string"
      },
      "summary": {
        "type": "string",
        "description": "short explanation of what changed"
      },
      "commit": {
        "type": "string",
        "description": "commit hash, if committed"
      },
      "acceptance": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "description": "1-based acceptance criterion number"
            },
            "result": {
              "type": "string",
              "description": "pass, fail, n/a or pending"
            },
            "evidence": {
              "type": "string",
              "description": "test name, command output, file:line, or why n/a"
            }
          },
          "required": [
            "index",
            "result"
          ],
          "additionalProperties": false
        },
        "description": "one entry per acceptance criterion (omit when the task has none)"
      },
      "validation": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "anyOf": [
            {
              "type": "string",
              "description": "a command that passed"
            },
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "result": {
                  "type": "string",
                  "description": "pass or fail"
                },
                "output": {
                  "type": "string",
                  "description": "short relevant output"
                }
              },
              "required": [
                "command",
                "result"
              ],
              "additionalProperties": false
            }
          ]
        },
        "description": "validation commands run: a command string (it passed) or {command, result, output}"
      },
      "proposals": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "one of: goal, constraint, decision, fact, open_question, warning, convention"
            },
            "content": {
              "type": "string",
              "description": "one short, self-contained statement"
            },
            "scope": {
              "type": "string",
              "description": "project (default), path:<dir or file>, subsystem:<name> or branch:<name>"
            },
            "source_ref": {
              "type": "string",
              "description": "where it came from: task id, commit, document, conversation topic"
            },
            "rationale": {
              "type": "string",
              "description": "why this looks settled, one line"
            },
            "supersedes": {
              "type": "string",
              "description": "id of a current memory this would replace"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false
        },
        "description": "durable decisions, conventions or warnings from this task that the user has not confirmed (stored for approval)"
      }
    },
    "required": [
      "id",
      "claim_token",
      "summary"
    ],
    "additionalProperties": false
  },
  "name": "task_complete",
  "outputSchema": {
    "type": "object",
    "properties": {
      "task": {
        "type": [
          "null",
          "object"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "blueprint": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "scope": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "acceptance": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "criterion": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
