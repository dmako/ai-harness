                      "type": "string"
                    },
                    "result": {
                      "type": "string"
                    },
                    "output": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "command",
                    "result"
                  ],
                  "additionalProperties": false
                }
              },
              "completed_by": {
                "type": "string"
              },
              "completed_at": {
                "type": "string"
              }
            },
            "required": [
              "summary",
              "completed_by",
              "completed_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "type"
        ],
        "additionalProperties": false
      },
      "claim_token": {
        "type": "string"
      },
      "unlocked": {
