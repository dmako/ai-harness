            ],
            "properties": {
              "claimant": {
                "type": "string"
              },
              "claimed_at": {
                "type": "string"
              },
              "lease_until": {
                "type": "string"
              }
            },
            "required": [
              "claimant"
            ],
            "additionalProperties": false
          },
          "completion": {
