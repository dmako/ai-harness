{
  "description": "Replace a current memory (e.g. a changed decision) with a new statement. The old one stays in history.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "current memory to replace"
      },
      "content": {
        "type": "string",
        "description": "the new statement"
      },
      "reason": {
        "type": "string",
        "description": "why it changed"
      },
      "type": {
        "type": "string",
        "description": "defaults to the old memory's type"
      },
      "scope": {
        "type": "string",
        "description": "defaults to the old memory's scope"
      },
      "source_ref": {
        "type": "string"
      },
      "source_type": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "content",
      "reason"
    ],
    "additionalProperties": false
  },
