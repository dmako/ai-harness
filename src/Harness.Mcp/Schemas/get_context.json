{
  "description": "Get the context for a task in one call, within a size budget: the relevant code grouped by file, with the areas (top-level directories) it spans (definitions with bodies while they fit, otherwise drill-down references; callers and impact), the decisions, conventions, constraints and warnings that apply to it, the architecture findings touching that code (as of the last sync, with the author's marks: explain and suggest, never act on one until it is a task), and recent changes. Describe the task in words and name the symbols you know. Read or search further only for what is still missing.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task": {
        "type": "string",
        "description": "the task in words, naming symbols you already know (e.g. TimetableOps.Copy)"
      },
      "path": {
        "type": "string",
        "description": "optional path prefix to stay within"
      },
      "budget": {
        "type": "integer",
        "description": "answer size in bytes (default 8000, at least 1000)"
      },
      "tokens": {
        "type": "integer",
        "description": "answer size in estimated tokens (instead of budget)"
      },
      "debug": {
        "type": "boolean",
        "description": "explain each unit's score and list sources"
      },
      "scope": {
        "type": "string",
        "description": "project (default) or workspace: also show matches from the other repositories in this project's workspaces"
      },
      "depth": {
        "type": "string",
        "description": "light (default; always start here) or deep. Use deep only when the user explicitly asks for deeper or compiler-exact cross-project answers: it starts heavy providers (graphify) in every member and can take up to 60 s"
      }
    },
    "required": [
      "task"
    ],
    "additionalProperties": false
  },
  "name": "get_context",
