{
  "description": "Report progress on a claimed task: status (in_progress, review, blocked with reason, or ready to release the claim), a note, and/or partial acceptance results. Renews the lease.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "claim_token": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "description": "in_progress, review, blocked (needs reason) or ready (releases the claim)"
      },
      "reason": {
        "type": "string",
        "description": "required when blocking"
      },
      "note": {
        "type": "string",
        "description": "progress note or discovered friction"
      },
      "acceptance": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "description": "1-based acceptance criterion number"
            },
            "result": {
              "type": "string",
              "description": "pass, fail, n/a or pending"
            },
            "evidence": {
              "type": "string",
              "description": "test name, command output, file:line, or why n/a"
            }
          },
          "required": [
            "index",
            "result"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "claim_token"
    ],
    "additionalProperties": false
  },
