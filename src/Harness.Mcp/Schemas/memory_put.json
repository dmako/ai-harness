{
  "description": "Store one durable project fact that future sessions and other agents need: a goal, constraint, decision, convention, warning, open question or fact. One short statement per call; never chat transcripts or code. If similar memories exist nothing is stored and they are returned: supersede one, or retry with force=true.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "description": "one of: goal, constraint, decision, fact, open_question, warning, convention"
      },
      "content": {
        "type": "string",
        "description": "one short, self-contained statement (max 4000 bytes)"
      },
      "scope": {
        "type": "string",
        "description": "project (default), path:<dir or file>, subsystem:<name>, branch:<name>; wider: workspace:<name> (every project in that workspace) or user (every project of this user)"
      },
      "source_ref": {
        "type": "string",
        "description": "where this came from: task id, commit, document, user request"
      },
      "source_type": {
        "type": "string",
        "description": "agent (default) or user when the user stated it"
      },
      "confidence": {
        "type": [
          "null",
          "number"
        ],
        "description": "0..1 for inferred facts"
      },
      "valid_until": {
        "type": "string",
        "description": "optional expiry (RFC 3339 or YYYY-MM-DD)"
      },
      "supersedes": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "string"
        },
        "description": "ids of current memories this replaces"
      },
      "reason": {
        "type": "string",
        "description": "why superseded memories are replaced"
      },
      "force": {
        "type": "boolean",
        "description": "store even if similar memories exist"
      }
    },
    "required": [
      "type",
      "content"
    ],
    "additionalProperties": false
  },
  "name": "memory_put",
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "memory": {
        "type": [
          "null",
          "object"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "null",
              "number"
            ]
          },
          "superseded_by": {
            "type": "string"
          },
          "supersede_reason": {
            "type": "string"
          },
          "valid_from": {
            "type": "string"
          },
          "valid_until": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "overrides": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "type",
          "content",
          "scope",
          "source_type",
          "source_ref",
          "recorded_by",
          "created_at"
        ],
        "additionalProperties": false
      },
      "similar": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "source_type": {
                  "type": "string"
                },
                "source_ref": {
                  "type": "string"
                },
                "recorded_by": {
                  "type": "string"
                },
                "confidence": {
                  "type": [
                    "null",
                    "number"
                  ]
                },
                "superseded_by": {
                  "type": "string"
                },
                "supersede_reason": {
                  "type": "string"
                },
                "valid_from": {
                  "type": "string"
                },
                "valid_until": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "overrides": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "type",
                "content",
                "scope",
                "source_type",
                "source_ref",
                "recorded_by",
                "created_at"
              ],
              "additionalProperties": false
            },
            "similarity": {
              "type": "number"
            }
          },
          "required": [
            "memory",
            "similarity"
          ],
          "additionalProperties": false
        }
      },
      "superseded": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "string"
        }
      },
      "hint": {
        "type": "string"
      }
    },
    "required": [
      "status"
    ],
    "additionalProperties": false
  }
}
